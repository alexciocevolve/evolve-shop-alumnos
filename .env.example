POSTGRES_PASSWORD=shop
# 127.0.0.1 y no localhost: el compose publica Postgres solo en 127.0.0.1. En Windows, `localhost`
# prueba antes ::1, y hay máquinas en las que esa conexión se queda colgada dos minutos antes de
# rendirse. Los tests pasan de tardar segundos a tardar minutos.
DATABASE_URL=postgresql+psycopg://shop:shop@127.0.0.1:5432/shop
# Páginas que pueden llamar a la API desde un navegador (orígenes separados por comas, sin
# ruta). Para desplegar el frontend en otro sitio, se añade aquí su dirección.
CORS_ORIGINS=http://localhost:5173

# La API key con la que Filebeat escribe en el Elasticsearch de `elastic-real`.
#
# NO se inventa: la crea el `preparar.sh` de ese conjunto al levantarlo, y la deja en
# ../python-demo/sesion-24/elastic-real/secretos/clave-python
#
# OJO AL FORMATO, que cuesta un rato descubrirlo. Ese fichero guarda la forma `encoded`,
# que es base64 y es la que quiere `curl` en la cabecera `Authorization: ApiKey ...`.
# Filebeat NO la acepta: quiere el par sin codificar, `id:api_key`, y con la otra contesta
# un escueto "invalid ApiKey value" que no dice nada del formato. Por eso hay un base64 -d.
#
# Para copiarla sin que aparezca por pantalla ni en el historial del terminal:
#
#   printf 'ELASTIC_API_KEY=%s
' #     "$(base64 -d < ../python-demo/sesion-24/elastic-real/secretos/clave-python)" >> .env
#
# Su alcance son los indices `logs-*`, que es justo por lo que el stream de esta tienda se
# llama `logs-shop-evolve` y no `shop-evolve` a secas.
ELASTIC_API_KEY=KEY1:SECRET1
ELASTIC_HOST=elasticsearch
COMPOSE_PROJECT_NAME=evolve-shop-alumnos

# The Stripe secret key. REQUIRED: without it the API refuses to start, on purpose - a
# shop that cannot charge is not a shop that should be taking orders.
#
# Get a test key without signing up for anything:  stripe sandbox create
# Or from the dashboard: https://dashboard.stripe.com/test/apikeys
#
# sk_test_ charges nobody and works with the test cards. sk_live_ moves real money, and
# the only place it belongs is the hosting provider's own secret store - never this file,
# never a Dockerfile, never a commit.
STRIPE_SECRET_KEY=sk_test_replace_me
